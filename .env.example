# ==============================================================================
# AI Recruitment Hub — Production Environment Configuration
# Copy this file to .env and provide your secret production values.
# ==============================================================================

# System Environment
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="AI Recruitment Hub"

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=ai_recruitment_hub
POSTGRES_PORT=5432

# FastAPI Backend URLs (Internal Docker Network)
DATABASE_URL=postgresql+asyncpg://postgres:your_strong_postgres_password_here@db:5432/ai_recruitment_hub
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:your_strong_postgres_password_here@db:5432/ai_recruitment_hub

# JWT Security (Generate with: openssl rand -hex 32)
SECRET_KEY=generate_a_64_character_hex_string_for_production_security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_PASSWORD_EXPIRE_MINUTES=30

# Initial Super Admin Seed Credentials
FIRST_SUPERADMIN_EMAIL=admin@recruitmenthub.ai
FIRST_SUPERADMIN_PASSWORD=Admin@StrongSecurePassword2026!
FIRST_SUPERADMIN_NAME="Platform Super Admin"

# Google Gemini Multimodal AI API (Required for CV Analysis & Live Voice/Video Interview)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ports & Hosts
BACKEND_PORT=8000
FRONTEND_PORT=80
