# Project & Environment
PROJECT_NAME="AI Recruitment Hub"
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_recruitment_hub
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_recruitment_hub

# Security & JWT Secrets
SECRET_KEY=your-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_PASSWORD_EXPIRE_MINUTES=30

# Initial Admin Seed
FIRST_SUPERADMIN_EMAIL=admin@recruitmenthub.ai
FIRST_SUPERADMIN_PASSWORD=Admin@123456
FIRST_SUPERADMIN_NAME="Platform Super Admin"

# Google Gemini API
GEMINI_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

